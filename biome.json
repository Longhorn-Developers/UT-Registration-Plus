{
    "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!!**/dist",
            "!.storybook",
            "!src/lib/chrome-extension-toolkit",
            "!**/*.svg",
            "!CHANGELOG.md"
        ]
    },
    "formatter": {
        "useEditorconfig": true,
        "enabled": true,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "overrides": [
        {
            "includes": ["src/stories/**"],
            "linter": {
                "rules": {
                    "correctness": {
                        "useHookAtTopLevel": "off"
                    }
                }
            }
        },
        {
            "includes": ["src/views/styles/colors.module.scss", "src/views/styles/fonts.module.scss"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnknownProperty": "off",
                        "noUnknownPseudoClass": "off"
                    }
                }
            }
        },
        {
            "includes": ["src/views/components/common/ExtensionRoot/ExtensionRoot.module.scss"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnknownUnit": "off"
                    }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "single",
            "trailingCommas": "es5",
            "semicolons": "always",
            "arrowParentheses": "asNeeded",
            "bracketSpacing": true,
            "bracketSameLine": false
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        },
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "yaml": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
